# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=crypto_market
POSTGRES_USER=crypto_user
POSTGRES_PASSWORD=12345

# Binance
BINANCE_EXCHANGE_INFO_URL=https://api.binance.com/api/v3/exchangeInfo
BINANCE_KLINES_URL=https://api.binance.com/api/v3/klines
BINANCE_REST_URL=https://api.binance.com/api/v3/ticker/24hr

# Historical daily OHLCV sync
BACKFILL_INTERVAL=1d
BACKFILL_LIMIT=1000
BACKFILL_SLEEP_SECONDS=0.25
BACKFILL_ERROR_SLEEP_SECONDS=5
BACKFILL_QUOTE_ASSETS=
BACKFILL_MAX_SYMBOLS=0
EXCLUDE_CURRENT_DAY=true
REPAIR_GAPS=true

# Realtime ticker snapshots
POLL_SECONDS=30
QUOTE_ASSETS=

# CoinGecko market metadata
COINGECKO_MARKETS_URL=https://api.coingecko.com/api/v3/coins/markets
COINGECKO_VS_CURRENCY=usd
COINGECKO_PER_PAGE=250
COINGECKO_MAX_PAGES=5
COINGECKO_START_PAGE=1
COINGECKO_SLEEP_SECONDS=20
COINGECKO_RATE_LIMIT_SLEEP_SECONDS=120
COINGECKO_SYNC_SECONDS=43200

# Alert worker
ALERT_CHECK_SECONDS=60
ALERT_DEFAULT_COOLDOWN_MINUTES=60

# SMTP email alerts
# For Gmail, use an App Password, not your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM_EMAIL=
